[Unit]
Description=Take a permdrift snapshot
Documentation=https://github.com/permdrift/permdrift

[Service]
Type=oneshot
# Root is needed to read /etc/shadow, /etc/sudoers and every ~/.ssh.
ExecStart=/usr/local/sbin/permdrift-snapshot.sh
# StateDirectory creates /var/lib/permdrift with mode 0700 and keeps it
# writable even though the rest of the file system is read only below.
StateDirectory=permdrift
StateDirectoryMode=0700
Environment=PERMDRIFT_BIN=/usr/local/bin/permdrift
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
# Do not add ProtectHome=yes. It would hide the home directories that
# permdrift is supposed to read.
