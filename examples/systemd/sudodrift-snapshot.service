[Unit]
Description=Take a sudodrift snapshot
Documentation=https://github.com/sudodrift/sudodrift

[Service]
Type=oneshot
# Root is needed to read /etc/shadow, /etc/sudoers and every ~/.ssh.
ExecStart=/usr/local/sbin/sudodrift-snapshot.sh
# StateDirectory creates /var/lib/sudodrift with mode 0700 and keeps it
# writable even though the rest of the file system is read only below.
StateDirectory=sudodrift
StateDirectoryMode=0700
Environment=SUDODRIFT_BIN=/usr/local/bin/sudodrift
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
# Do not add ProtectHome=yes. It would hide the home directories that
# sudodrift is supposed to read.
